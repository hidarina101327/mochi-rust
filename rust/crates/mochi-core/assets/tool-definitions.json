      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": ".mcb 路径；省略使用当前 .mcb"
          },
          "tableId": {
            "type": "string"
          },
          "recordId": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": true,
            "description": "待修改字段 ID 到合法单元格值的映射；不传的字段保持原样"
          },
          "expectedValues": {
            "type": "object",
            "additionalProperties": true,
            "description": "可选的上次读取原始值，发生变化时拒绝覆盖；缺失字段与 null 视为空值"
          }
        },
        "required": [
          "tableId",
          "recordId",
          "values"
        ],
        "additionalProperties": false
      }
    }
  },
