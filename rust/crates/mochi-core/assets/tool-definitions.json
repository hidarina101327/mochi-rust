[
  {
    "type": "function",
    "function": {
      "name": "base_get_schema",
      "description": "读取 .mcb 多维表格的表、字段类型、选项与视图，不返回全部记录。先用此工具取得稳定 ID；path 省略时使用当前 .mcb 文档。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "工作区相对路径或工作区内绝对路径；省略仅使用当前 .mcb"
          },
          "tableId": {
            "type": "string",
            "description": "可选的数据表 ID，指定时仅返回该表结构"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "base_query_records",
      "description": "按字段 ID 查询 .mcb 记录，支持视图、AND 筛选、排序、搜索和分页，返回原始值、显示文字及稳定记录链接。最多返回 100 条，查询不改变文件。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": ".mcb 路径；省略使用当前 .mcb"
          },
          "tableId": {
            "type": "string",
            "description": "base_get_schema 返回的数据表 ID"
          },
          "viewId": {
            "type": "string",
            "description": "可选视图 ID；应用该视图的筛选与排序"
          },
          "filters": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "fieldId": {
                  "type": "string"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "contains",
                    "equals",
                    "notEquals",
                    "isEmpty",
                    "isNotEmpty"
                  ]
                },
                "value": {
                  "type": [
                    "null",
                    "string",
                    "number",
                    "boolean",
                    "array"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "fieldId",
                "operator"
              ],
              "additionalProperties": false
            },
            "description": "追加 AND 筛选；选择字段 equals 用选项 ID，contains 用显示文字"
          },
          "sorts": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "fieldId": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                }
              },
              "required": [
                "fieldId",
                "direction"
              ],
              "additionalProperties": false
            },
            "description": "指定时替代视图排序"
          },
          "search": {
            "type": "string",
            "description": "在全部字段显示文字中搜索"
          },
          "fieldIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            },
            "description": "只返回这些字段；省略返回全部字段"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "跳过的匹配记录数，默认 0"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "默认 20，最大 100"
          }
        },
        "required": [
          "tableId"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
