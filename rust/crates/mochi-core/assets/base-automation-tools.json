                                  "type"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "type",
                        "values"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "createRecord"
                        },
                        "tableId": {
                          "type": "string"
                        },
                        "values": {
                          "type": "object",
                          "minProperties": 1,
                          "maxProperties": 100,
                          "additionalProperties": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "const": "literal"
                                  },
                                  "value": {}
                                },
                                "required": [
                                  "type",
                                  "value"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "const": "field"
                                  },
                                  "fieldId": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "type",
                                  "fieldId"
                                ],
                                "additionalProperties": false
                              },
