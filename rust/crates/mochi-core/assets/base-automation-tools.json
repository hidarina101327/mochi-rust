          "path": {
            "type": "string",
            "description": ".mcb路径，省略使用当前文档"
          },
          "tableId": {
            "type": "string",
            "description": "可选，限定数据表"
          },
          "viewId": {
            "type": "string",
            "description": "可选，限定视图"
          },
          "ruleId": {
            "type": "string",
            "description": "可选，限定规则"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
