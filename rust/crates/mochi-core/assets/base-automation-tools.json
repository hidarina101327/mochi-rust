                      "enum": [
                        "contains",
                        "equals",
                        "notEquals",
                        "isEmpty",
                        "isNotEmpty"
                      ]
                    },
                    "value": {}
                  },
                  "required": [
                    "fieldId",
                    "operator"
                  ],
                  "additionalProperties": false
                }
              },
